<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Heredar el reporte estándar de cotización de Odoo para agregar título del proyecto y atendido por -->
    <template id="report_saleorder_document_inherit" inherit_id="sale.report_saleorder_document">

        <!-- Ocultar los placeholders vacíos (cámara/imagen) que wkhtmltopdf renderiza cuando no hay contenido -->
        <xpath expr="//div[@class='page']" position="before">
            <style>
                /* Los bloques oe_structure son solo contenedores de edición, no deben verse en el PDF */
                .oe_structure { display: none !important; }
                /* Ocultar imágenes sin src para evitar el placeholder de cámara sobre la cotización */
                img:not([src]), img[src=""] { display: none !important; }
            </style>
        </xpath>
        
        <!-- Agregar Título del Proyecto antes del título de la cotización -->
        <xpath expr="//t[@t-set='layout_document_title']" position="before">
            <div t-if="doc.project_name"
                 class="mb-3"
                 style="margin-top: 10px; margin-bottom: 18px; display: block;">
                <div style="font-size: 20pt; font-weight: 600; line-height: 1.1;">
                    Proyecto:
                </div>
                <div style="font-size: 18pt; font-weight: 600; color: #000; line-height: 1.4;">
                    <span t-field="doc.project_name"/>
                </div>
            </div>
        </xpath>

        <!-- Dar un poco más de respiro a la fila de información principal -->
        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="style">margin-bottom: 2rem; row-gap: 12px; column-gap: 16px;</attribute>
        </xpath>
        
        <!-- Agregar Atendido por en la sección de informaciones -->
        <xpath expr="//div[@id='informations']/div[@name='informations_date']" position="after">
            <div t-if="doc.attended_by_employee_id" class="col" name="informations_attended_by">
                <strong>Atendido por</strong>
                <div t-field="doc.attended_by_employee_id"/>
            </div>
        </xpath>
        
    </template>
</odoo>
