<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Asegurar que la acción reuse el formato por defecto -->
    <record id="action_report_invoice_huby" model="ir.actions.report">
        <field name="paperformat_id" eval="False"/>
        <field name="report_name">huby_personalize.report_invoice_document_huby</field>
    </record>

    <!-- Mantener la plantilla base de Odoo y únicamente añadir los campos personalizados -->
    <template id="report_invoice_document_huby" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='informations']" position="after">
            <t t-set="huby_orders" t-value="o.invoice_line_ids.mapped('sale_line_ids.order_id')"/>
            <t t-set="huby_order" t-value="huby_orders and huby_orders[0] or False"/>
            <div t-if="huby_order and (huby_order.project_name or huby_order.attended_by_employee_id)"
                 class="row mb-3"
                 name="huby_project_attended_block">
                <div class="col" t-if="huby_order.project_name">
                    <strong>Proyecto</strong>
                    <div t-esc="huby_order.project_name"/>
                </div>
                <div class="col" t-if="huby_order.attended_by_employee_id">
                    <strong>Atendido por</strong>
                    <div t-field="huby_order.attended_by_employee_id"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
